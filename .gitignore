# data, media and weights are never tracked (licences differ from the code's)
data/
*.mp4
*.avi
*.mov
*.mkv
*.pt
*.pth
*.onnx
weights/
runs/
outputs/

# raw per-frame detector/tracker output: large, regenerable from data/ + code.
# Only the metric files computed from them are tracked.
results/detections/
results/tracks/

# error-analysis renders are real frames (faces): never published, regenerate with `sightline errors`
results/error_analysis/**/*.png

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
